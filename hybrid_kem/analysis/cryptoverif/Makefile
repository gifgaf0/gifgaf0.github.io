# Reproduce the CryptoVerif (computational) analysis of HYBRID-AKE.
# See README.md for what each model proves.
#
# Requires CryptoVerif 2.13 and m4. Build CryptoVerif from its source
# distribution (https://cryptoverif.inria.fr/cryptoverif2.13.tar.gz; its
# sha512 is pinned in ocaml/opam-repository,
# packages/cryptoverif/cryptoverif.2.13/opam) with `./build`, then:
#
#     make CVHOME=$HOME/cryptoverif2.13
#
# CVHOME must contain the `cryptoverif` binary and the libraries default.ocvl
# and pq.ocvl (as a source build does). With an opam install, use
#     make CRYPTOVERIF=cryptoverif CVLIBDIR=$(opam var prefix)/doc/cryptoverif

CVHOME      ?= $(HOME)/cryptoverif2.13
CRYPTOVERIF ?= $(CVHOME)/cryptoverif
CVLIBDIR    ?= $(CVHOME)
M4          ?= m4

# Post-quantum-sound library (no random oracles, no Diffie-Hellman
# assumptions) and the default (classical) library.
PQ  = -lib $(CVLIBDIR)/pq
STD = -lib $(CVLIBDIR)/default

GEN  = gen
LOGS = logs

PQ_SRC  = hybrid_ake hybrid_ake_ephleak
PQ_GEN  = composite_sig.MLDSA_SECURE composite_sig.EDDSA_SECURE \
          kem_bbfgs.MLKEM_SECURE kem_xwing.MLKEM_SECURE
STD_GEN = kem_bbfgs.X25519_SECURE kem_xwing.X25519_SECURE
ALL     = $(PQ_SRC) $(PQ_GEN) $(STD_GEN)

.PHONY: all protocol composite kem mutations clean
.SECONDARY:

# Run every model, then write RESULTS.txt (the proved bounds) and fail if
# any query is unproved.
all: $(ALL:%=$(LOGS)/%.log)
	@{ echo "CryptoVerif results for HYBRID-AKE (generated by make; see README.md)"; \
	   $(CRYPTOVERIF) -help 2>&1 | head -1; echo; \
	   for m in $(ALL); do \
	     echo "==== $$m"; \
	     grep -E '^(RESULT Proved|RESULT Could|RESULT time|All queries proved)' $(LOGS)/$$m.log; \
	     grep -E '^Error' $(LOGS)/$$m.log; echo; \
	   done; } > RESULTS.txt
	@echo "=== summary ==="; fail=; \
	for m in $(ALL); do \
	  if grep -q '^All queries proved\.' $(LOGS)/$$m.log; then echo "PROVED      $$m"; \
	  else echo "NOT PROVED  $$m"; fail=1; fi; done; \
	test -z "$$fail"

protocol:  $(PQ_SRC:%=$(LOGS)/%.log)
composite: $(LOGS)/composite_sig.MLDSA_SECURE.log $(LOGS)/composite_sig.EDDSA_SECURE.log
kem:       $(LOGS)/kem_bbfgs.MLKEM_SECURE.log $(LOGS)/kem_bbfgs.X25519_SECURE.log \
           $(LOGS)/kem_xwing.MLKEM_SECURE.log $(LOGS)/kem_xwing.X25519_SECURE.log

# m4 variants <model>.<VARIANT>.ocv of <model>.m4.ocv
$(GEN)/%.ocv:
	@mkdir -p $(GEN)
	$(M4) -D $(subst .,,$(suffix $*)) $(basename $*).m4.ocv > $@
$(GEN)/composite_sig.MLDSA_SECURE.ocv $(GEN)/composite_sig.EDDSA_SECURE.ocv: composite_sig.m4.ocv
$(GEN)/kem_bbfgs.MLKEM_SECURE.ocv $(GEN)/kem_bbfgs.X25519_SECURE.ocv: kem_bbfgs.m4.ocv
$(GEN)/kem_xwing.MLKEM_SECURE.ocv $(GEN)/kem_xwing.X25519_SECURE.ocv: kem_xwing.m4.ocv

# Full CryptoVerif output (game sequence, bounds) of each run.
$(PQ_SRC:%=$(LOGS)/%.log): $(LOGS)/%.log: %.ocv
	@mkdir -p $(LOGS)
	$(CRYPTOVERIF) $(PQ) $< > $@ 2>&1 || true
$(PQ_GEN:%=$(LOGS)/%.log): $(LOGS)/%.log: $(GEN)/%.ocv
	@mkdir -p $(LOGS)
	$(CRYPTOVERIF) $(PQ) $< > $@ 2>&1 || true
$(STD_GEN:%=$(LOGS)/%.log): $(LOGS)/%.log: $(GEN)/%.ocv
	@mkdir -p $(LOGS)
	$(CRYPTOVERIF) $(STD) $< > $@ 2>&1 || true

# Mutation tests: weakened models on which the same proofs must NOT go
# through (see mutations.py for the list and the expected outcomes).
mutations:
	python3 mutations.py --cryptoverif $(CRYPTOVERIF) --libdir $(CVLIBDIR) --m4 $(M4)

clean:
	rm -rf $(GEN) $(LOGS)
