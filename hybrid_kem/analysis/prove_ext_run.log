lemma responder_auth_injective:
  all-traces
  "∀ pkI pkR s epk TH sess #i.
    (((I_Commit( pkI, pkR, s, epk, TH, sess ) @ #i) ∧
      (∃ #h. Register( pkR ) @ #h)) ∧
     (¬(∃ #r. Compromise( pkR ) @ #r))) ⇒
    (∃ #j.
      ((R_Running( pkR, pkI, s, epk, TH, sess ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ pkI2 pkR2 s2 epk2 sess2 #i2.
          (I_Commit( pkI2, pkR2, s2, epk2, TH, sess2 ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ pkI pkR s epk TH sess #i.
