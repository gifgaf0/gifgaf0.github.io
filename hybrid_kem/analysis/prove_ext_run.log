guarded formula characterizing all satisfying traces:
"∃ pkI pkR s epk TH sess #i #e #k.
  (I_Commit( pkI, pkR, s, epk, TH, sess ) @ #i) ∧
  (EphReveal( epk ) @ #e) ∧
  (K( sess ) @ #k)"
*/
simplify
solve( St_I1( pk(~ltkI), ~ltkI, ~e, s ) ▶₀ #i )
  case I_1_case_1
  solve( !EphKey( kempk(~e), ~e.2 ) ▶₀ #e.1 )
    case I_1
    solve( splitEqs(0) )
      case split_case_1
      solve( !KU( kdf(decap(~e, ct),
                      h(<'suiteA', pk(~ltkI), pk(x), kempk(~e), ct>))
             ) @ #vk.5 )
        case c_kdf
        solve( !KU( decap(~e, ct) ) @ #vk.6 )
          case c_decap
          solve( !KU( h(<'suiteA', pk(~ltkI), pk(x), kempk(~e), ct>) ) @ #vk.7 )
            case c_h
            solve( !KU( sign(<'respAuth', 
                              h(<'suiteA', pk(~ltkI), pk(x), kempk(~e), ct>)>,
                             x)
                   ) @ #vk.9 )
              case c_sign
              solve( !KU( pk(x) ) @ #vk.6 )
                case I_1_case_1
                solve( !KU( ~ltkI.1 ) @ #vk.17 )
                  case Reveal_ltk
                  solve( !KU( ~e ) @ #vk.14 )
                    case Reveal_eph
                    solve( !KU( pk(~ltkI) ) @ #vk.16 )
                      case I_1_case_1
                      solve( !KU( kempk(~e) ) @ #vk.17 )
                        case I_1
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

