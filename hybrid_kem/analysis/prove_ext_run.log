lemma executable:
  exists-trace
  "∃ pkI pkR s epk TH sess #i #j.
    ((((I_Commit( pkI, pkR, s, epk, TH, sess ) @ #i) ∧
       (R_Commit( pkR, pkI, s, epk, TH, sess ) @ #j)) ∧
      (¬(∃ #r. Compromise( pkI ) @ #r))) ∧
     (¬(∃ #r. Compromise( pkR ) @ #r))) ∧
    (¬(∃ #r. EphReveal( epk ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ pkI pkR s epk TH sess #i #j.
  (I_Commit( pkI, pkR, s, epk, TH, sess ) @ #i) ∧
  (R_Commit( pkR, pkI, s, epk, TH, sess ) @ #j)
 ∧
  (∀ #r. (Compromise( pkI ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Compromise( pkR ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (EphReveal( epk ) @ #r) ⇒ ⊥)"
*/
simplify
solve( St_I1( pk(~ltkI), ~ltkI, ~e, s ) ▶₀ #i )
  case I_1_case_1
  solve( St_R( pk(x), ~ltkR, pk(~ltkI), 'suiteA', kempk(~e),
               h(<'suiteA', pk(~ltkI), pk(x), kempk(~e), ct>), sigR,
               kdf(z, h(<'suiteA', pk(~ltkI), pk(x), kempk(~e), ct>))
         ) ▶₀ #j )
    case R_1
    solve( !KU( sign(<'respAuth', 
                      h(<'suiteA', pk(~ltkI), pk(~ltkR), kempk(~e), encap(kempk(~e), ~ss)>)>,
                     ~ltkR)
           ) @ #vk.4 )
      case R_1
      solve( !KU( sign(<'initAuth', 
                        h(<
                           h(<'suiteA', pk(~ltkI), pk(~ltkR), kempk(~e), encap(kempk(~e), ~ss)>), 
                           sign(<'respAuth', 
                                 h(<'suiteA', pk(~ltkI), pk(~ltkR), kempk(~e), encap(kempk(~e), ~ss)>)>,
                                ~ltkR)
                          >)
                       >,
                       ~ltkI)
             ) @ #vk.5 )
        case I_2
        solve( !KU( pk(~ltkR) ) @ #vk.4 )
          case I_1_case_1
          solve( !KU( pk(~ltkI) ) @ #vk.9 )
            case I_1_case_1
            solve( !KU( kempk(~e) ) @ #vk.10 )
              case I_1
              solve( !KU( encap(kempk(~e), ~ss) ) @ #vk.8 )
                case R_1
                SOLVED // trace found
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma eph_reveal_breaks_session:
  exists-trace
  "∃ pkI pkR s epk TH sess #i #e #k.
    ((I_Commit( pkI, pkR, s, epk, TH, sess ) @ #i) ∧
