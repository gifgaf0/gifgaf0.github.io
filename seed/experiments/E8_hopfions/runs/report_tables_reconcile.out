 "verdicts": [
  {
   "claim": "SEED sec. 4: E/Q^{3/4} stays near 1.2, so the energy per unit charge falls and bigger folds store charge more cheaply",
   "verdict": "CONFIRMED (Q = 1-7)",
   "evidence": "E/Q^{3/4} = 1.185-1.245 at dx = 0.1 and 1.19-1.25 in the same-box continuum; E/Q falls monotonically; every E_Q is 10-19% below its cheapest split. Energies are those of the solutions reached from one start per charge (upper bounds on the minima; they match Sutcliffe's survey)."
  },
  {
   "claim": "E_2 < 2 E_1: a charge-2 fold does not split",
   "verdict": "CONFIRMED",
   "evidence": "E_2/(2E_1) = 0.8149 at dx = 0.1, 0.8166 in infinite volume (axial code); cross-check spectral 0.8166"
  },
  {
   "claim": "SEED sec. 4/6C: Q = 7 is a trefoil",
   "verdict": "CONFIRMED as a reproduction of the literature minimum (trefoil-type minimum reached from the preregistered trefoil start; global minimality not re-searched here: one start per charge, so it rests on Sutcliffe's survey)",
   "evidence": "one position loop with Alexander polynomial t^2-t+1 (3 projections, dx = 0.15 and 0.1), Q_link = 7, E_7/E_1 = 4.3645 vs 4.3538"
  },
  {
   "claim": "SEED sec. 4: E >= c|Q|^{3/4}; the 3/4 power is the right one and the computed minima agree (Sutcliffe 2007)",
   "verdict": "AMENDED",
   "evidence": "all energies above Q^{3/4} and 0.534 Q^{3/4}; fitted exponent 0.764 over Q <= 7 (Sutcliffe's table 0.763), consistent with but not a test of the asymptotic 3/4; optimality is Lin & Yang 2004 (PLAN 3.1)"
  },
  {
   "claim": "SEED sec. 4/6C: the lowest folds are rings and each charge's minimum is a definite knot or link",
   "verdict": "CONFIRMED as a reproduction of the literature types (one start per charge; that these are the global minima rests on Sutcliffe's survey)",
   "evidence": "A11, A21, bent A~31, A22, L^{1,1}_{1,2}, L^{1,1}_{2,2}, K32, all as in Sutcliffe Table 2"
  }
 ]
}
